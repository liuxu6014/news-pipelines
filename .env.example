# 复制为 .env 后按需修改；.env 不会提交到 git

# 通用
LOG_LEVEL=INFO
HTTPCACHE_ENABLED=false
SSRF_PROTECTION_ENABLED=true
SSRF_ALLOWED_HOSTS=

# MySQL
MYSQL_ENABLED=0
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=crawler
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_TABLE=rss_news
MYSQL_CHARSET=utf8mb4
MYSQL_CONNECT_TIMEOUT=10
MYSQL_BATCH_SIZE=100
MYSQL_FAIL_ON_ERROR=1
MYSQL_DEAD_LETTER_INCLUDE_ROWS=0
MYSQL_MAX_FAILED_BATCHES=20
MYSQL_RETRY_TIMES=0
MYSQL_RETRY_BACKOFF_SECONDS=1.0

# PostgreSQL（Kafka consumer 的目标库）
PG_ENABLED=0
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=pipesight
PG_USER=postgres
PG_PASSWORD=
PG_TABLE=news_articles
PG_CONNECT_TIMEOUT=10
PG_BATCH_SIZE=100
PG_FAIL_ON_ERROR=1
PG_DEAD_LETTER_INCLUDE_ROWS=0
PG_MAX_FAILED_BATCHES=20
PG_RETRY_TIMES=0
PG_RETRY_BACKOFF_SECONDS=1.0

# pipe-sight 数据源门控：run_spider.py 读 data_sources.is_enabled 决定跑哪些 spider
# 0=关闭（默认跑全部）；1=只跑 pipe-sight 中 is_enabled=true 的 spider
PIPESIGHT_SOURCE_GATE=0
# 门控开启时，data_sources 里没有对应行的 spider 是否允许运行：1=允许，0=必须显式注册
PIPESIGHT_SOURCE_GATE_ALLOW_UNKNOWN=1

# Kafka -> PostgreSQL consumer (tools/kafka_consume.py)
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=news_pipeline
KAFKA_GROUP_ID=news-pipelines-rss-consumer
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_COMMIT_INTERVAL_MSGS=100

# spider-monitor
SPIDER_MONITOR_ENABLED=1
SPIDER_MONITOR_PROJECT=app
SPIDER_MONITOR_ENV=local
SPIDER_MONITOR_ENDPOINT=
SPIDER_MONITOR_FAIL_ON_ERROR=0
SPIDER_MONITOR_OWNER=
SPIDER_MONITOR_OWNER_EMAIL=
SPIDER_MONITOR_OWNER_PHONE=
SPIDER_MONITOR_OWNER_TEAM=
SPIDER_MONITOR_MIN_ITEMS=0
SPIDER_MONITOR_MAX_DROPPED=0
SPIDER_MONITOR_MAX_SPIDER_ERRORS=0
SPIDER_MONITOR_MAX_DB_ERRORS=0
SPIDER_MONITOR_FAIL_ON_QUALITY_ERROR=0
SPIDER_MONITOR_FIELD_ALLOWLIST=canonical_url,url_hash,content_hash,source,source_site,source_category,domain,publish_time
